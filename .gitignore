# Original notebooks, superseded by the locomotion/ package. Kept locally for
# reference; they remain available in the git history of this repository.
/legacy/

# Datasets and experiment outputs. These patterns are anchored with a leading
# slash so they match only the top-level folders -- an unanchored 'data/' would
# also exclude the locomotion/data package.
/data/
/outputs/
*.npz
*.pt
*.h5
*.ckpt

# Python
__pycache__/
*.py[cod]
*.egg-info/
build/
dist/
.venv/
venv/
env/

# Tooling
.pytest_cache/
.mypy_cache/
.ruff_cache/
.ipynb_checkpoints/
.coverage
htmlcov/

# Editors / OS
.vscode/
.idea/
.DS_Store
Thumbs.db
